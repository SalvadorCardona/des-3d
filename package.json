{
  "name": "des-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Un lanceur de dés 3D en Three.js et Rapier — web, iOS et Android depuis un seul code.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:native": "tsc --noEmit && CAP_BUILD=1 vite build && cap sync",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify-physics.mts"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/three": "^0.185.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
